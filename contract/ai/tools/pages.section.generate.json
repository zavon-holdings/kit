{
  "tool_key": "pages.section.generate",
  "mode": "inline",
  "input": {
    "instruction": "Add a section with our opening hours and a link to the visit page.",
    "allowed_types": [
      "button",
      "heading",
      "text"
    ],
    "block_schemas": {
      "button": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "href",
          "label"
        ]
      },
      "heading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eyebrow": {
            "type": "string",
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "text"
        ]
      },
      "text": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "page_title": "Visit",
    "context_blocks": [
      {
        "type": "heading",
        "data": {
          "text": "Visit"
        }
      },
      {
        "type": "button",
        "data": {
          "label": "Plan your visit",
          "href": "https://example.org/visit"
        }
      }
    ]
  },
  "result": {
    "blocks": [
      {
        "type": "heading",
        "data": {
          "eyebrow": "Visit",
          "text": "Opening hours"
        }
      },
      {
        "type": "text",
        "data": {
          "text": "Monday to Friday, 08:00 to 17:00."
        }
      },
      {
        "type": "button",
        "data": {
          "href": "https://example.org/visit",
          "label": "Plan your visit"
        }
      }
    ],
    "summary": "A heading, the hours and the visit link."
  }
}
