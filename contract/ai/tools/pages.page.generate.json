{
  "tool_key": "pages.page.generate",
  "mode": "job",
  "input": {
    "instruction": "A page about our volunteer programme.",
    "title": "Volunteer",
    "allowed_types": [
      "button",
      "heading",
      "text"
    ],
    "block_schemas": {
      "button": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "href",
          "label"
        ]
      },
      "heading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eyebrow": {
            "type": "string",
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "text"
        ]
      },
      "text": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "site_name": "Example Organisation"
  },
  "result": {
    "title": "Volunteer",
    "blocks": [
      {
        "type": "heading",
        "data": {
          "text": "Volunteer with us"
        }
      },
      {
        "type": "text",
        "data": {
          "text": "Give a few hours a month and help your community."
        }
      }
    ],
    "summary": "A heading and an introduction."
  }
}
