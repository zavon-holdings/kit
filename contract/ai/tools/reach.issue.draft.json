{
  "tool_key": "reach.issue.draft",
  "mode": "inline",
  "input": {
    "brief": "Monthly update: the new hall opens on 1 November.",
    "merge_tags": [
      "{{recipient.first_name}}",
      "{{recipient.last_name}}",
      "{{recipient.name}}",
      "{{org.name}}"
    ],
    "allowed_types": [
      "button",
      "divider",
      "heading",
      "quote",
      "text"
    ],
    "block_schemas": {
      "button": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://"
          }
        },
        "required": [
          "label",
          "url"
        ]
      },
      "divider": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "heading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "text"
        ]
      },
      "quote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ]
      },
      "text": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "issue_title": "November update",
    "locale": "en"
  },
  "result": {
    "subject": "The new hall opens on 1 November",
    "preheader": "Everything you need to know",
    "blocks": [
      {
        "type": "text",
        "data": {
          "text": "Hello {{recipient.first_name|there}}, the new hall opens on 1 November."
        }
      },
      {
        "type": "divider",
        "data": {}
      },
      {
        "type": "quote",
        "data": {
          "text": "Everybody is welcome. {{org.name}}"
        }
      }
    ],
    "summary": "A greeting with the date, a divider and a quote."
  }
}
