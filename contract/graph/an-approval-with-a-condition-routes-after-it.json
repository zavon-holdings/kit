{
  "name": "an-approval-with-a-condition-routes-after-it",
  "direction": "compile",
  "graph": {
    "edges": [
      {
        "from": "start",
        "to": "sign"
      },
      {
        "from": "sign",
        "label": "signed",
        "to": "publish",
        "when": {
          "field": "steps.sign.output.approved_by",
          "op": "exists"
        }
      },
      {
        "default": true,
        "from": "sign",
        "label": "rejected",
        "to": "back"
      },
      {
        "from": "publish",
        "to": "done"
      }
    ],
    "format": "workflow.graph/1",
    "nodes": [
      {
        "id": "start",
        "type": "start"
      },
      {
        "config": {
          "assignees": [
            {
              "people": [
                {
                  "email": "lead@example.test",
                  "name": "Lead"
                }
              ]
            }
          ],
          "mode": "any"
        },
        "id": "sign",
        "type": "approval"
      },
      {
        "config": {
          "action": "content.page.publish"
        },
        "id": "publish",
        "type": "call"
      },
      {
        "config": {
          "outcome": "approved"
        },
        "id": "done",
        "type": "end"
      },
      {
        "config": {
          "outcome": "rejected"
        },
        "id": "back",
        "type": "end"
      }
    ]
  },
  "steps": [
    {
      "code": "sign",
      "name": "sign",
      "kind": "approval",
      "config": {
        "assignees": [
          {
            "people": [
              {
                "email": "lead@example.test",
                "name": "Lead"
              }
            ]
          }
        ],
        "mode": "any",
        "on_reject": "continue"
      }
    },
    {
      "code": "sign--route",
      "name": "After sign",
      "kind": "branch",
      "config": {
        "cases": [
          {
            "goto": "publish",
            "when": {
              "field": "steps.sign.output.approved_by",
              "op": "exists"
            }
          }
        ],
        "default": "back"
      }
    },
    {
      "code": "publish",
      "name": "publish",
      "kind": "call",
      "config": {
        "action": "content.page.publish"
      }
    },
    {
      "code": "done",
      "name": "done",
      "kind": "end",
      "config": {
        "outcome": "approved"
      }
    },
    {
      "code": "back",
      "name": "back",
      "kind": "end",
      "config": {
        "outcome": "rejected"
      }
    }
  ]
}
