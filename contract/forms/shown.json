              "value": true
            },
            "type": "text"
          },
          {
            "key": "company_stage",
            "label": "Stage",
            "options": [
              "Idea",
              "Revenue"
            ],
            "required": true,
            "show_when": {
              "field": "answers.company_name",
              "op": "exists"
            },
            "type": "single_choice"
          }
        ],
        "key": "about_you",
        "title": "About you"
      },
      {
        "fields": [
          {
            "key": "revenue",
            "label": "Annual revenue",
            "required": true,
            "type": "number"
          }
        ],
        "key": "funding",
        "show_when": {
          "field": "answers.company_stage",
          "op": "is",
          "value": "Revenue"
        },
        "title": "Funding"
      },
      {
        "fields": [
          {
            "label": "Before you send",
            "type": "section"
          },
          {
            "key": "agree",
            "label": "I confirm what I have written is true",
            "required": true,
            "type": "acknowledgement"
          }
        ],
        "key": "consent",
        "title": "Consent"
      }
    ],
    "title": "Accelerator application"
  },
