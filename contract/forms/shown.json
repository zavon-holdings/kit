{
  "name": "shown",
  "kind": "shown",
  "definition": {
    "pages": [
      {
        "fields": [
          {
            "key": "full_name",
            "label": "Full name",
            "required": true,
            "type": "text"
          },
          {
            "key": "has_company",
            "label": "Do you already have a company?",
            "required": true,
            "type": "yes_no"
          },
          {
            "key": "company_name",
            "label": "Company name",
            "required": true,
            "show_when": {
              "field": "answers.has_company",
